{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneDoor local MVP connector manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "lifecycle", "display", "routing", "endpoint", "auth", "tools"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$", "maxLength": 40 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 40 },
    "lifecycle": { "type": "string", "enum": ["active", "disabled"] },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "capabilities", "prompts"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 400 },
        "capabilities": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": { "type": "string", "maxLength": 120 }
        },
        "prompts": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["title", "description", "message", "icon"],
            "properties": {
              "title": { "type": "string", "maxLength": 80 },
              "description": { "type": "string", "maxLength": 120 },
              "message": { "type": "string", "maxLength": 200 },
              "icon": { "type": "string", "enum": ["balance", "invoice", "terms", "search"] }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["keywords", "excludeKeywords"],
      "properties": {
        "keywords": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "excludeKeywords": {
          "type": "array", "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        }
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "binding", "protocolVersion"],
      "properties": {
        "kind": { "type": "string", "enum": ["mcp"] },
        "binding": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$", "maxLength": 40 },
        "protocolVersion": { "type": "string", "enum": ["2026-07-28"] }
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["audience"],
      "properties": {
        "audience": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "tools": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "scope", "risk", "pin"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$", "maxLength": 80 },
          "scope": { "type": "string", "minLength": 1, "maxLength": 80 },
          "risk": { "type": "string", "enum": ["read"] },
          "pin": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "maxLength": 71 }
        }
      }
    }
  }
}
